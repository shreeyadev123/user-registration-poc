APP_NAME=Laravel
APP_ENV=local
APP_KEY=secret
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=laravel-mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=laravel-redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis


# Looking to send emails in production? Check out our Email API/SMTP product!
MAIL_MAILER=mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=62d6a******
MAIL_PASSWORD=6f*******
WEBHOOK_SITE_URL=https://webhook.site/

# Sync Service Configuration
SYNC_SERVICE_HOST=sync-app
SYNC_SERVICE_PORT=9000

# Build URLs
SYNC_SERVICE_BASE_URL="http://${SYNC_SERVICE_HOST}:${SYNC_SERVICE_PORT}"
SYNC_SERVICE_HEALTH_URL="${SYNC_SERVICE_BASE_URL}/api/health"
SYNC_SERVICE_SYNC_URL="${SYNC_SERVICE_BASE_URL}/api/sync-user"
